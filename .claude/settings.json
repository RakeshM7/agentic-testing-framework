{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|WebFetch|WebSearch|Agent|Task|mcp__.*playwright.*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR:+$CLAUDE_PROJECT_DIR/}packages/core/scripts/hooks/pretooluse.mjs\" --host claude-code" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|Agent|Task",
        "hooks": [
          { "type": "command", "async": true, "command": "node \"${CLAUDE_PROJECT_DIR:+$CLAUDE_PROJECT_DIR/}packages/core/scripts/hooks/posttooluse.mjs\" --host claude-code" }
        ]
      }
    ]
  }
}
