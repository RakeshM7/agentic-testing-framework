node_modules/
playwright-tests/*/playwright-report/
playwright-tests/*/test-results/
.env
.env.*
!.env.example
!**/.env.example
!**/.env.*.example
playwright-tests/*/.auth/
*.log
.DS_Store


# Pipeline run output is generated and local: artifacts/<run-id>/. Commit a curated, sanitized run under
# examples/ if you want to share one. Nothing under artifacts/ is tracked except this keep-file.
artifacts/*
!artifacts/.gitkeep

# Stray Playwright output from running tests at the repo root
/test-results/
/playwright-report/

# The orchestrator's run-config interview answers (D-063); the drafted config/<product>.yaml is what to keep
config/interview-answers.json

# Saved browser session (credentials); never commit
auth.json

# The built @testagentic/atf (packages/core/scripts/build-package.mjs): published by the release workflow, never committed
packages/core/dist/

# The built Claude Code plugin (packages/core/scripts/build-plugin.mjs): pushed to the marketplace repository by the release
# workflow, never committed here
packages/claude-plugin/dist/

# The built VS Code extension (packages/vscode/scripts/build.mjs and package.mjs): dist/extension.js and the vsix,
# published to the VS Code Marketplace and Open VSX by the release workflow, never committed
packages/vscode/dist/
