{
  "name": "atf-vscode",
  "displayName": "atf: agentic testing",
  "description": "A UI for the atf agentic testing framework: run status, the clarifications and test case approval sheets, and run reports. Requires the licensed @testagentic/atf package installed in your workspace; without it, the extension does nothing.",
  "version": "0.1.4",
  "publisher": "testagentic",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#16202c",
    "theme": "dark"
  },
  "pricing": "Free",
  "qna": false,
  "categories": [
    "Testing"
  ],
  "keywords": [
    "atf",
    "testagentic",
    "agentic testing",
    "playwright",
    "k6",
    "test cases"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "atf runs the @testagentic/atf scripts installed in the workspace's node_modules, so it works only in a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "atf runs Node.js scripts on the workspace's files, which needs a folder on disk."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:atf/atf.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "atf",
          "title": "ATF",
          "icon": "media/atf.svg"
        }
      ]
    },
    "views": {
      "atf": [
        {
          "id": "atf.runs",
          "name": "Products"
        },
        {
          "id": "atf.clarifications",
          "name": "Clarifications",
          "when": "atf.workspaceState == ok"
        },
        {
          "id": "atf.approvals",
          "name": "Test case approval",
          "when": "atf.workspaceState == ok"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "atf.runs",
        "contents": "No atf project is open.\n[Create new project…](command:atf.createProject)\n[Open existing project…](command:atf.openProject)",
        "when": "atf.workspaceState == noFolder"
      },
      {
        "view": "atf.runs",
        "contents": "This folder isn't an atf project yet.\n[Create new project…](command:atf.createProject)\n[Open existing project…](command:atf.openProject)",
        "when": "atf.workspaceState == noWorkspace"
      },
      {
        "view": "atf.runs",
        "contents": "Creating a project asks once for a GitHub token with read:packages. [Connect now](command:atf.connect)",
        "when": "atf.workspaceState =~ /^no(Folder|Workspace)$/ && !atf.registryConnected"
      },
      {
        "view": "atf.runs",
        "contents": "The framework isn't installed in this project yet.\n[Install the framework](command:atf.installFramework)\n[Refresh](command:atf.refresh)",
        "when": "atf.workspaceState == noFramework"
      },
      {
        "view": "atf.runs",
        "contents": "atf/atf.json can't be read. Correct it, then refresh.\n[Refresh](command:atf.refresh)",
        "when": "atf.workspaceState == badMarker"
      },
      {
        "view": "atf.runs",
        "contents": "No products yet. A product starts with its run-config, config/<product>.yaml: what to test, and where.\n[New product…](command:atf.newProduct)\nNot sure what to put in it? [Let the orchestrator interview me](command:atf.newProduct?%5B%22interview%22%5D) and draft it with you.",
        "when": "atf.workspaceState == ok"
      }
    ],
    "walkthroughs": [
      {
        "id": "atf.getStarted",
        "title": "Get started with atf",
        "description": "Connect to the package registry, create a project, add a product and start your first run.",
        "steps": [
          {
            "id": "connect",
            "title": "Connect to the package registry",
            "description": "The framework is a licensed package on GitHub's package registry. Installing it needs a GitHub classic personal access token with the read:packages scope. atf asks for it once and keeps it in VS Code's secret storage.\n[Connect](command:atf.connect)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onContext:atf.registryConnected"
            ]
          },
          {
            "id": "project",
            "title": "Create or open a project",
            "description": "A project is the folder that holds atf/atf.json, the framework and your products. Create one, or open one you already have.\n[Create new project…](command:atf.createProject)\n[Open existing project…](command:atf.openProject)",
            "media": {
              "markdown": "media/walkthrough/project.md"
            },
            "completionEvents": [
              "onContext:atf.workspaceState == ok"
            ]
          },
          {
            "id": "product",
            "title": "Add a product",
            "description": "A product is what you test. Its run-config says what to test, and where.\n[New product…](command:atf.newProduct)",
            "media": {
              "markdown": "media/walkthrough/product.md"
            },
            "completionEvents": [
              "onContext:atf.hasProducts"
            ]
          },
          {
            "id": "host",
            "title": "Choose where agents run",
            "description": "Optional: runs open in Claude Code by default. You can choose VS Code Chat with GitHub Copilot (copilot-chat) or Copilot CLI (copilot-cli) instead.\n[Choose where agents run](command:workbench.action.openSettings?%5B%22atf.host%22%5D)",
            "media": {
              "markdown": "media/walkthrough/host.md"
            },
            "completionEvents": [
              "onSettingChanged:atf.host",
              "onStepSelected"
            ]
          },
          {
            "id": "run",
            "title": "Start your first run",
            "description": "A run is readonly by default. full-run is only for a target you're authorized to test.\n[Start a run](command:atf.run)",
            "media": {
              "markdown": "media/walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:atf.run"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "atf.refresh",
        "title": "Refresh",
        "category": "atf",
        "icon": "$(refresh)"
      },
      {
        "command": "atf.createProject",
        "title": "Create new project…",
        "category": "atf",
        "icon": "$(new-folder)"
      },
      {
        "command": "atf.openProject",
        "title": "Open existing project…",
        "category": "atf",
        "icon": "$(folder-opened)"
      },
      {
        "command": "atf.connect",
        "title": "Connect to the package registry…",
        "category": "atf",
        "icon": "$(plug)"
      },
      {
        "command": "atf.forgetToken",
        "title": "Forget the registry token",
        "category": "atf",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "atf.installFramework",
        "title": "Install the framework",
        "category": "atf",
        "icon": "$(cloud-download)"
      },
      {
        "command": "atf.init",
        "title": "Set up atf in this folder (init)",
        "category": "atf",
        "icon": "$(new-folder)"
      },
      {
        "command": "atf.sync",
        "title": "Sync host files",
        "category": "atf",
        "icon": "$(sync)"
      },
      {
        "command": "atf.check",
        "title": "Check host files",
        "category": "atf",
        "icon": "$(checklist)"
      },
      {
        "command": "atf.doctor",
        "title": "Doctor",
        "category": "atf",
        "icon": "$(pulse)"
      },
      {
        "command": "atf.run",
        "title": "Start or continue a run",
        "category": "atf",
        "icon": "$(play)"
      },
      {
        "command": "atf.resume",
        "title": "Resume a stage",
        "category": "atf",
        "icon": "$(debug-continue)"
      },
      {
        "command": "atf.newProduct",
        "title": "New product…",
        "category": "atf",
        "icon": "$(add)"
      },
      {
        "command": "atf.openConfig",
        "title": "Open config",
        "category": "atf",
        "icon": "$(go-to-file)"
      },
      {
        "command": "atf.validate",
        "title": "Validate config",
        "category": "atf",
        "icon": "$(check)"
      },
      {
        "command": "atf.sweep",
        "title": "Sweep leftovers…",
        "category": "atf",
        "icon": "$(trash)"
      },
      {
        "command": "atf.openClarifications",
        "title": "Open clarifications",
        "category": "atf",
        "icon": "$(question)"
      },
      {
        "command": "atf.openApproval",
        "title": "Open approval sheet",
        "category": "atf",
        "icon": "$(tasklist)"
      },
      {
        "command": "atf.approveModule",
        "title": "Approve module…",
        "category": "atf",
        "icon": "$(pass)"
      },
      {
        "command": "atf.openReport",
        "title": "Open report",
        "category": "atf",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "atf.init",
          "when": "atf.workspaceState == noWorkspace"
        },
        {
          "command": "atf.installFramework",
          "when": "atf.workspaceState == noFramework"
        },
        {
          "command": "atf.forgetToken",
          "when": "atf.registryConnected"
        },
        {
          "command": "atf.sync",
          "when": "atf.active"
        },
        {
          "command": "atf.check",
          "when": "atf.active"
        },
        {
          "command": "atf.doctor",
          "when": "atf.active"
        },
        {
          "command": "atf.run",
          "when": "atf.active"
        },
        {
          "command": "atf.resume",
          "when": "atf.active"
        },
        {
          "command": "atf.newProduct",
          "when": "atf.active"
        },
        {
          "command": "atf.openConfig",
          "when": "atf.active"
        },
        {
          "command": "atf.validate",
          "when": "atf.active"
        },
        {
          "command": "atf.sweep",
          "when": "atf.active"
        },
        {
          "command": "atf.openClarifications",
          "when": "atf.active"
        },
        {
          "command": "atf.openApproval",
          "when": "atf.active"
        },
        {
          "command": "atf.approveModule",
          "when": "atf.active"
        },
        {
          "command": "atf.openReport",
          "when": "atf.active"
        }
      ],
      "view/title": [
        {
          "command": "atf.newProduct",
          "when": "view == atf.runs && atf.active",
          "group": "navigation@0"
        },
        {
          "command": "atf.run",
          "when": "view == atf.runs && atf.active",
          "group": "navigation@1"
        },
        {
          "command": "atf.refresh",
          "when": "view == atf.runs || view == atf.clarifications || view == atf.approvals",
          "group": "navigation@9"
        },
        {
          "command": "atf.doctor",
          "when": "view == atf.runs && atf.active",
          "group": "1_run@1"
        },
        {
          "command": "atf.resume",
          "when": "view == atf.runs && atf.active",
          "group": "1_run@2"
        },
        {
          "command": "atf.sync",
          "when": "view == atf.runs && atf.active",
          "group": "2_host@1"
        },
        {
          "command": "atf.check",
          "when": "view == atf.runs && atf.active",
          "group": "2_host@2"
        },
        {
          "command": "atf.createProject",
          "when": "view == atf.runs",
          "group": "3_setup@1"
        },
        {
          "command": "atf.openProject",
          "when": "view == atf.runs",
          "group": "3_setup@2"
        }
      ],
      "view/item/context": [
        {
          "command": "atf.run",
          "when": "view == atf.runs && viewItem =~ /^atf\\.(product|environment)$/",
          "group": "inline@1"
        },
        {
          "command": "atf.run",
          "when": "view == atf.runs && viewItem =~ /^atf\\.(product|environment)$/",
          "group": "1_run@1"
        },
        {
          "command": "atf.doctor",
          "when": "view == atf.runs && viewItem =~ /^atf\\.(product|environment)$/",
          "group": "1_run@2"
        },
        {
          "command": "atf.resume",
          "when": "view == atf.runs && viewItem =~ /^atf\\.(product|environment|run|module)$/",
          "group": "1_run@3"
        },
        {
          "command": "atf.resume",
          "when": "view == atf.runs && viewItem == atf.stage",
          "group": "inline@1"
        },
        {
          "command": "atf.resume",
          "when": "view == atf.runs && viewItem == atf.stage",
          "group": "1_run@1"
        },
        {
          "command": "atf.validate",
          "when": "view == atf.runs && viewItem =~ /^atf\\.(product|environment)$/",
          "group": "1_run@4"
        },
        {
          "command": "atf.sweep",
          "when": "view == atf.runs && viewItem =~ /^atf\\.(product|environment)$/",
          "group": "4_cleanup@1"
        },
        {
          "command": "atf.openConfig",
          "when": "view == atf.runs && viewItem =~ /^atf\\.(product|environment)$/",
          "group": "2_open@1"
        },
        {
          "command": "atf.openReport",
          "when": "view == atf.runs && viewItem == atf.run",
          "group": "inline@1"
        },
        {
          "command": "atf.openReport",
          "when": "view == atf.runs && viewItem == atf.run",
          "group": "2_open@1"
        },
        {
          "command": "atf.openClarifications",
          "when": "viewItem =~ /^atf\\.(product|module|clarificationProduct|clarificationModule|clarificationRow)$/",
          "group": "2_open@2"
        },
        {
          "command": "atf.openClarifications",
          "when": "view == atf.clarifications && viewItem =~ /^atf\\.(clarificationProduct|clarificationModule)$/",
          "group": "inline@1"
        },
        {
          "command": "atf.openApproval",
          "when": "viewItem =~ /^atf\\.(module|approvalModule|approvalCase)$/",
          "group": "2_open@3"
        },
        {
          "command": "atf.openApproval",
          "when": "view == atf.approvals && viewItem == atf.approvalModule",
          "group": "inline@1"
        },
        {
          "command": "atf.approveModule",
          "when": "viewItem =~ /^atf\\.(module|approvalModule)$/",
          "group": "3_approve@1"
        }
      ]
    },
    "configuration": {
      "title": "atf",
      "properties": {
        "atf.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The Node.js the extension runs the installed `@testagentic/atf` scripts with. Empty: `node` on the PATH."
        },
        "atf.host": {
          "type": "string",
          "enum": [
            "claude",
            "copilot-chat",
            "copilot-cli"
          ],
          "enumDescriptions": [
            "Claude Code: `claude --agent orchestrator-agent` in a terminal tab in the editor area (Claude Code's panel can't pick the agent).",
            "VS Code Chat (GitHub Copilot): the chat opens with the run's first prompt, for you to send to the orchestrator-agent.",
            "Copilot CLI: `copilot --agent orchestrator-agent` in a terminal tab in the editor area."
          ],
          "default": "claude",
          "markdownDescription": "Where **Start or continue a run**, **Resume a stage** and the interview open the orchestrator-agent session. The earlier value `copilot` is read as `copilot-cli`. For `claude` and `copilot-cli`, the `ATF_AGENT` environment variable still overrides the command (`atf run --host`)."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:smoke": "node test/smoke/run.mjs"
  },
  "devDependencies": {
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  }
}
