{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "testcases-review.schema.json",
  "title": "results/<run>/<m>/testcases/review.json: the testcase-reviewer's verdict on every current case in one review round, the only file it writes. `testcases.mjs review-check` checks that every case has a verdict and derives the overall verdict (pass exactly when no blocker or major remains) into review-findings.md.",
  "type": "object",
  "required": ["module", "round", "cases"],
  "additionalProperties": false,
  "$defs": {
    "version": { "type": "string", "pattern": "^v[0-9a-f]{12}$", "description": "The case's version the verdict judged (coverage.json cases[].version); a verdict for an earlier version does not count." },
    "finding": {
      "type": "object",
      "required": ["severity", "problem", "fix"],
      "additionalProperties": false,
      "properties": {
        "severity": { "enum": ["blocker", "major", "minor"], "description": "blocker: wrong expected behavior; major: not automatable, or contradicts the evidence; minor: wording." },
        "rule": { "enum": ["correctness", "evidence", "automatable", "independence", "wording", "other"] },
        "problem": { "type": "string", "minLength": 1 },
        "fix": { "type": "string", "minLength": 1 }
      }
    }
  },
  "properties": {
    "module": { "type": "string" },
    "round": { "type": "integer", "minimum": 1, "description": "The review round in the reviewer's prompt; a verdict from another round does not count." },
    "cases": {
      "type": "object",
      "propertyNames": { "pattern": "^TC-[a-z0-9]+(-[a-z0-9]+)*-[1-9][0-9]*$" },
      "additionalProperties": {
        "oneOf": [
          { "type": "object", "required": ["verdict", "version"], "additionalProperties": false, "properties": { "verdict": { "const": "ok" }, "version": { "$ref": "#/$defs/version" } } },
          { "type": "object", "required": ["verdict", "version", "findings"], "additionalProperties": false, "properties": { "verdict": { "const": "finding" }, "version": { "$ref": "#/$defs/version" }, "findings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/finding" } } } }
        ]
      }
    },
    "general": { "type": "array", "items": { "$ref": "#/$defs/finding" }, "description": "Findings not about one case." }
  }
}
