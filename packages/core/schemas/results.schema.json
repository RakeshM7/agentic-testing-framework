{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "results.schema.json",
  "title": "Normalized execution results (artifacts/<product>/results/<run-id>/<module>/<framework>/results.json) -- written only by scripts/results.mjs",
  "type": "object",
  "required": ["framework", "module", "runId", "mode", "recordedAt", "status", "totals", "durationMs", "items"],
  "additionalProperties": false,
  "properties": {
    "framework": { "enum": ["playwright-ui", "playwright-api", "k6"] },
    "module": { "type": "string" },
    "runId": { "type": "string" },
    "mode": { "enum": ["readonly", "full-run"] },
    "recordedAt": { "type": "string" },
    "status": { "enum": ["ran", "not-run"] },
    "reason": { "type": "string" },
    "totals": {
      "type": "object",
      "required": ["total", "passed", "failed", "flaky", "skipped"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "flaky": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "durationMs": { "type": "number", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": { "type": "string" },
          "file": { "type": "string" },
          "status": { "enum": ["passed", "failed", "flaky", "skipped"] },
          "durationMs": { "type": "number" },
          "error": { "type": "string" },
          "tcId": { "type": "string", "pattern": "^TC-.+-\\d+$", "description": "UI: the case id the generated test's title starts with" },
          "scenarioId": { "type": "string", "pattern": "^API-.+-\\d+$", "description": "API: the plan scenario id the title starts with" },
          "tcIds": { "type": "array", "items": { "type": "string" }, "description": "API: the approved cases the test's @TC tags name" },
          "k6Id": { "type": "string", "pattern": "^K6-.+-\\d+$", "description": "k6: the id in the generated script's header" },
          "project": { "type": "string" },
          "attempts": { "type": "integer", "minimum": 0, "description": "how many times the test ran (retries included)" },
          "passedOnRetry": { "type": "boolean" },
          "frames": { "type": "array", "items": { "type": "string" }, "description": "the failing run's top stack frames, path:line" },
          "attachments": { "type": "array", "items": { "type": "object", "required": ["name", "path"], "properties": { "name": { "type": "string" }, "path": { "type": "string" } } } },
          "skipReason": { "type": "string" },
          "smoke": { "type": "boolean" },
          "checks": { "type": "object" },
          "p95Ms": { "type": ["number", "null"] },
          "httpFailRate": { "type": ["number", "null"] },
          "thresholds": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}
