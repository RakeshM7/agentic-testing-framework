{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundation-k6-overlay.schema.json",
  "title": "artifacts/<product>/foundation/k6-overlay.json: k6-lib-writer's cited choices for the k6 lib (the auth scheme, base path, default headers) and the missing-export requests it resolved in lib/ext/, rendered into lib/settings.js by scripts/foundation.mjs (D-054). Credentials come only from K6_USER, K6_PASSWORD and K6_TOKEN.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "cite": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(clarification|testcase|knowledge|spec|observation):\\S+$" } },
    "module": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  },
  "properties": {
    "auth": {
      "type": "object",
      "required": ["scheme", "cite"],
      "additionalProperties": false,
      "properties": {
        "scheme": { "enum": ["none", "session", "bearer", "basic", "api-key", "oauth2"] },
        "header": { "type": ["string", "null"] },
        "prefix": { "type": "string" },
        "cookie": { "type": ["string", "null"] },
        "module": { "$ref": "#/$defs/module" },
        "cite": { "$ref": "#/$defs/cite" }
      }
    },
    "basePath": {
      "type": "object",
      "required": ["path", "cite"],
      "additionalProperties": false,
      "properties": { "path": { "type": "string" }, "module": { "$ref": "#/$defs/module" }, "cite": { "$ref": "#/$defs/cite" } }
    },
    "defaultHeaders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "cite"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "value": { "type": "string", "maxLength": 200 }, "module": { "$ref": "#/$defs/module" }, "cite": { "$ref": "#/$defs/cite" } }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "text", "cite"],
        "additionalProperties": false,
        "properties": { "topic": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 }, "module": { "$ref": "#/$defs/module" }, "cite": { "$ref": "#/$defs/cite" } }
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "text", "files", "exports", "cite"],
        "additionalProperties": false,
        "properties": {
          "kind": { "const": "missing-export" },
          "text": { "type": "string", "minLength": 1, "description": "The exports k6-script-writer reported missing." },
          "requestedBy": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" }, "description": "lib/ext/<name>.js files that provide them." },
          "exports": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z_$][\\w$]*$" } },
          "module": { "$ref": "#/$defs/module" },
          "cite": { "$ref": "#/$defs/cite" }
        }
      }
    }
  }
}
