{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundation-api-overlay.schema.json",
  "title": "artifacts/<product>/foundation/api-overlay.json: pw-api-scaffolder's cited API judgments (base paths, the auth scheme, default headers), rendered into config/api/settings.ts and config/api/README.md by scripts/foundation.mjs (D-054). Variable names only, never credential values.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "cite": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(clarification|testcase|knowledge|spec|observation):\\S+$" } },
    "module": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "note": {
      "type": "object",
      "required": ["topic", "text", "cite"],
      "additionalProperties": false,
      "properties": { "topic": { "type": "string", "minLength": 1 }, "text": { "type": "string", "minLength": 1 }, "module": { "$ref": "#/$defs/module" }, "cite": { "$ref": "#/$defs/cite" } }
    },
    "request": {
      "type": "object",
      "required": ["kind", "text", "files", "exports", "cite"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "gap" },
        "text": { "type": "string", "minLength": 1 },
        "requestedBy": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" }, "description": "The extension files that fill it (fixtures/api/index.ts, helpers/api/** except schema.ts)." },
        "exports": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_$][\\w$]*$" } },
        "module": { "$ref": "#/$defs/module" },
        "cite": { "$ref": "#/$defs/cite" }
      }
    }
  },
  "properties": {
    "basePaths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "cite"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }, "path": { "type": "string" }, "module": { "$ref": "#/$defs/module" }, "cite": { "$ref": "#/$defs/cite" } }
      }
    },
    "auth": {
      "type": "object",
      "required": ["scheme", "cite"],
      "additionalProperties": false,
      "properties": {
        "scheme": { "enum": ["none", "session", "bearer", "basic", "api-key", "oauth2"] },
        "header": { "type": ["string", "null"] },
        "prefix": { "type": "string" },
        "env": { "type": ["string", "null"], "description": "The NAME of the variable holding the token or key." },
        "cookie": { "type": ["string", "null"], "description": "The session cookie's name (session scheme)." },
        "module": { "$ref": "#/$defs/module" },
        "cite": { "$ref": "#/$defs/cite" }
      }
    },
    "defaultHeaders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "cite"],
        "additionalProperties": false,
        "properties": { "name": { "type": "string" }, "value": { "type": "string", "maxLength": 200 }, "module": { "$ref": "#/$defs/module" }, "cite": { "$ref": "#/$defs/cite" } }
      }
    },
    "timeoutMs": {
      "type": "object",
      "required": ["value", "cite"],
      "additionalProperties": false,
      "properties": { "value": { "type": "integer" }, "module": { "$ref": "#/$defs/module" }, "cite": { "$ref": "#/$defs/cite" } }
    },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/note" } },
    "requests": { "type": "array", "items": { "$ref": "#/$defs/request" } }
  }
}
