{
  "variables": {
    "product_dir": "artifacts/${product}",
    "knowledge": "artifacts/${product}/knowledge",
    "modules": "artifacts/${product}/modules/${module}",
    "state": "artifacts/${product}/state",
    "results": "artifacts/${product}/results/${run_id}",
    "pw_project": "playwright-tests/${product}",
    "k6_project": "k6-tests/${product}"
