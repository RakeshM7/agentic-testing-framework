    "orchestrator-agent": {
      "layer": 0,
      "spawns": [
        "knowledge-generator",
        "module-explorer",
        "api-discoverer",
        "clarification-orchestrator",
        "testcase-orchestrator",
        "playwright-ui-orchestrator",
        "playwright-api-orchestrator",
        "k6-orchestrator",
        "report-generator",
        "pw-repo-owner"
      ],
      "live_target": {
        "browser": "none",
        "http": "none",
        "load": "none"
      },
      "web_research": "none",
      "shell": "restricted",
      "shell_allow": [
        "node node_modules/@testagentic/atf/scripts/run.mjs *",
        "node node_modules/@testagentic/atf/scripts/run-config.mjs *",
        "node node_modules/@testagentic/atf/scripts/ledger.mjs list *",
        "node node_modules/@testagentic/atf/scripts/knowledge.mjs *",
        "node node_modules/@testagentic/atf/scripts/clarifications.mjs status *",
        "node node_modules/@testagentic/atf/scripts/testcases.mjs import *",
        "node node_modules/@testagentic/atf/scripts/framework-issues.mjs add *"
      ],
      "filesystem": {
        "read": [
          "${product_dir}/**",
          "config/**"
        ],
        "write": [
          "${state}/notes.md",
          "config/interview-answers.json",
          "${state}/scenario-answers.json"
        ]
      },
      "ask_user": "allowed",
      "browser_session": "shared"
    },
