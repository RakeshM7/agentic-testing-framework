      "filesystem": {
        "read": [
          "config/**",
          "${state}/config.resolved.json",
          "${knowledge}/**",
          "<requirement docs and references listed in the run-config>"
        ],
        "write": [
          "${knowledge}/overview.md",
          "${knowledge}/glossary.md",
          "${knowledge}/captures/**",
          "${knowledge}/modules/${module}/overview.md",
          "${knowledge}/modules/${module}/glossary.md",
          "${knowledge}/modules/${module}/notes.md"
