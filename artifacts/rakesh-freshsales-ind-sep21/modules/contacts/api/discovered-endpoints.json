{
  "source": "live probe of trial tenant with session state + Freshworks CRM docs + explore captures (2026-10-05)",
  "base": "https://rakesh-freshsales-ind-sep21.myfreshworks.com",
  "auth": "session cookie (storageState hand-off) for reads; mutations additionally need X-CSRF-Token from <meta name=csrf-token>",
  "endpoints": [
    {"method":"GET","path":"/crm/sales/contacts/filters","response":"{filters:[{id,name,model_class_name,is_default}],meta}","note":"saved views incl. Recycle Bin"},
    {"method":"GET","path":"/crm/sales/contacts/filters/:id","response":"{filter:{id,name,is_default,...}}"},
    {"method":"GET","path":"/crm/sales/contacts/view/:viewId","query":["page","per_page","sort","sort_type"],"response":"{contacts:[...],meta:{total,total_pages}}","note":"unknown view -> 403"},
    {"method":"GET","path":"/crm/sales/contacts?segment_id=:viewId","query":["page","per_page","segment_id"],"note":"without segment_id -> 403"},
    {"method":"GET","path":"/crm/sales/contacts/:id","query":["include"],"response":"{contact,users,contact_status,lifecycle_stages}"},
    {"method":"POST","path":"/crm/sales/contacts","request":"{contact:{first_name,last_name,email,job_title,mobile_number,work_number,external_id,...}}","response":"{contact}","note":"Email required (mobile/external_id-only -> 400); dup -> 400"},
    {"method":"PUT","path":"/crm/sales/contacts/:id","request":"{contact:{...}}","response":"{contact}"},
    {"method":"DELETE","path":"/crm/sales/contacts/:id","response":"true","note":"soft delete to Recycle Bin"},
    {"method":"PUT","path":"/crm/sales/contacts/:id/restore","response":"{contact,users,meta}"},
    {"method":"POST","path":"/crm/sales/contacts/bulk_destroy","request":"{selected_ids:[...]}","response":"{message:'Contact deleted.'}"},
    {"method":"GET","path":"/crm/sales/contacts/:id/timeline_feeds","response":"{timeline_feeds:[],meta}"},
    {"method":"GET","path":"/crm/sales/contacts/:id/activities","response":"{activities:[],meta}"},
    {"method":"GET","path":"/crm/sales/contacts/:id/appointments","response":"{appointments:[],meta}","note":"probed only"},
    {"method":"GET","path":"/crm/sales/lookup?q=:email&f=email&entities=contact","response":"{contacts:{contacts:[...]}}","note":"eventually consistent"},
    {"method":"GET","path":"/crm/sales/search?q=:term&include=contact","response":"[{id,name,email,owner,type}]","note":"eventually consistent"},
    {"method":"GET","path":"/crm/sales/settings/contacts/fields","response":"{fields:[{label,name,type,required,...}]}"},
    {"method":"POST","path":"/crm/sales/notes","request":"{note:{description,targetable_id,targetable_type:'Contact'}}","response":"{note}"},
    {"method":"DELETE","path":"/crm/sales/notes/:id","response":"{success:'200'}"},
    {"method":"POST","path":"/crm/sales/tasks","note":"probed once (201); out of scope for this suite (sales-activities track owns it)"}
  ]
}
