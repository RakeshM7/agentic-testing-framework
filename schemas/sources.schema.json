{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sources.schema.json",
  "title": "Knowledge source registry (artifacts/<product>/knowledge/sources.json) -- written only by scripts/knowledge.mjs",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "title", "location", "type", "accessed", "addedBy", "runId"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^S[1-9][0-9]*$" },
      "title": { "type": "string", "minLength": 1 },
      "location": { "type": "string", "minLength": 1, "description": "URL or repo-relative file path, normalized" },
      "type": { "enum": ["vendor-doc", "knowledge-base", "requirement", "web", "live-product"] },
      "accessed": { "type": "string" },
      "addedBy": { "type": "string", "description": "'_product' or the module slug whose pass registered it" },
      "runId": { "type": "string" }
    }
  }
}
