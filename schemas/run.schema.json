{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.schema.json",
  "title": "Current run state (artifacts/<product>/state/run.json)",
  "type": "object",
  "required": ["layoutVersion", "product", "runId", "createdAt", "target", "mode", "configPath", "permissionsPath", "modules", "stages"],
  "additionalProperties": false,
  "properties": {
    "layoutVersion": { "const": 2 },
    "product": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "runId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "createdAt": { "type": "string" },
    "target": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string" } } },
    "mode": { "enum": ["readonly", "full-run"], "description": "Single source of truth for the safety mode; caps every agent's permissions." },
    "configPath": { "type": "string" },
    "permissionsPath": { "type": "string" },
    "modules": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "stages": {
      "type": "object",
      "description": "Keyed '<scope>/<stage>' where scope is '_product' or a module slug.",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "additionalProperties": false,
        "properties": {
          "status": { "enum": ["pending", "running", "done", "failed"] },
          "attempts": { "type": "integer", "minimum": 0 },
          "startedAt": { "type": "string" },
          "finishedAt": { "type": "string" },
          "error": { "type": "string" }
        }
      }
    }
  }
}
