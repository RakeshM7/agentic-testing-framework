{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-testing-framework/schemas/models.schema.json",
  "title": "Per-agent model assignment",
  "description": "config/models.yaml, the single source of truth consumed by scripts/sync-agent-models.mjs.",
  "type": "object",
  "required": ["agents"],
  "additionalProperties": false,
  "properties": {
    "agents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-agent$" },
      "additionalProperties": {
        "type": "object",
        "required": ["claude", "copilot"],
        "additionalProperties": false,
        "properties": {
          "claude": { "type": "string", "minLength": 1 },
          "copilot": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            ]
          }
        }
      }
    }
  }
}
