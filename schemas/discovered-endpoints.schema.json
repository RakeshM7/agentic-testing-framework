{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentic-testing-framework/schemas/discovered-endpoints.schema.json",
  "title": "api-testing-agent discovered endpoints",
  "description": "artifacts/<target>/api/discovered-endpoints.json. Only the fields every consumer relies on are required; per-target extras (OpenAPI-derived schemas, observed samples) are allowed.",
  "type": "object",
  "required": ["target", "baseUrl", "endpoints"],
  "properties": {
    "target": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "pattern": "^https?://" },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["method", "pathTemplate"],
        "properties": {
          "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
          "pathTemplate": { "type": "string", "pattern": "^/" },
          "resource": { "type": "string" },
          "queryParams": {},
          "note": { "type": "string" }
        }
      }
    }
  }
}
