{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sitemap.schema.json",
  "title": "explore/sitemap.json",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["url", "slug", "title"],
    "properties": {
      "url": { "type": "string" },
      "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "title": { "type": "string" },
      "screenshotPath": { "type": "string" },
      "domSnapshotPath": { "type": "string" },
      "networkRequestsPath": { "type": "string" },
      "consoleLogPath": { "type": "string" },
      "links": { "type": "array", "items": { "type": "string" } }
    }
  }
}
