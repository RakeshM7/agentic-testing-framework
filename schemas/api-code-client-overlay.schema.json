{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api-code-client-overlay.schema.json",
  "title": "api-code/client-overlay.json: pw-api-client-writer's judgments on the generated clients (D-056), applied by scripts/api-code.mjs build. Every entry is cited; a spec: citation names one of the entry's own endpoints' spec sources, and every name or value appears verbatim (whole words, whole tokens) in a cited source.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "cite": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(clarification|knowledge|spec|observation):.+$" } }
  },
  "properties": {
    "classes": {
      "type": "object",
      "description": "A naming fix per resource (its slug, as the catalogue gives it): the client class name.",
      "additionalProperties": { "type": "object", "required": ["name", "cite"], "additionalProperties": false, "properties": { "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*Client$" }, "cite": { "$ref": "#/$defs/cite" } } }
    },
    "methods": {
      "type": "object",
      "description": "A naming fix per endpoint (EP id): the method name.",
      "propertyNames": { "pattern": "^EP-" },
      "additionalProperties": { "type": "object", "required": ["name", "cite"], "additionalProperties": false, "properties": { "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }, "cite": { "$ref": "#/$defs/cite" } } }
    },
    "edgeCases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["endpoint", "kind", "cite"],
        "additionalProperties": false,
        "properties": {
          "endpoint": { "type": "string", "pattern": "^EP-" },
          "kind": { "enum": ["content-type", "header", "note"], "description": "content-type: how the body is sent; header: a fixed non-credential header the endpoint needs; note: a documented quirk, rendered as the method's doc comment." },
          "name": { "type": "string" },
          "value": { "type": "string" },
          "text": { "type": "string" },
          "cite": { "$ref": "#/$defs/cite" }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "content-type" } } }, "then": { "required": ["value"] } },
          { "if": { "properties": { "kind": { "const": "header" } } }, "then": { "required": ["name", "value"] } },
          { "if": { "properties": { "kind": { "const": "note" } } }, "then": { "required": ["text"] } }
        ]
      }
    }
  }
}
