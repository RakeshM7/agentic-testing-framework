# Copy to .env and fill in. Never commit .env. Values are read by utils/shared/env.ts and playwright.config.ts.
# Credentials (if any) live only in the .env file the run-config's credentials_file points to.

# Target application (UI) base URL
BASE_URL=
# Target API base URL (the api projects use this as baseURL)
API_BASE_URL=
# Optional: path to a human-produced Playwright storage state (relative paths resolve from this folder)
STORAGE_STATE=

# Set by the runner from artifacts/<product>/state/run.json -- readonly | full-run
ATF_MODE=
ATF_PRODUCT=
ATF_RUN_ID=
# Framework repo root (used to call scripts/ledger.mjs)
ATF_REPO_ROOT=

# Optional ledger metadata overrides (defaults: ATF_STAGE=playwright, ATF_AGENT=playwright-test)
ATF_STAGE=
ATF_AGENT=
