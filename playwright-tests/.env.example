# Copy this file to .env and fill in real values. Never commit .env.
# Credentials for a real, explicitly authorized EventHub test account
# (https://eventhub.rahulshettyacademy.com) used by tests/setup/auth.setup.ts
# to log in once and share a storage-state session across the suite.
EVENTHUB_EMAIL=your-test-account@example.com
EVENTHUB_PASSWORD=your-test-account-password
