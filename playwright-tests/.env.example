# Copy this file to .env and fill in real values. Never commit .env.
# Credentials for a real, explicitly authorized EventHub test account
# (https://eventhub.rahulshettyacademy.com) used by tests/setup/auth.setup.ts
# to log in once and share a storage-state session across the suite.
EVENTHUB_EMAIL=your-test-account@example.com
EVENTHUB_PASSWORD=your-test-account-password

# --- Optional overrides (defaults shown). Leave unset for the original targets. ---
# EVENTHUB_BASE_URL=https://eventhub.rahulshettyacademy.com
# EVENTHUB_API_URL=https://api.eventhub.rahulshettyacademy.com/api
# FRESHSALES_BASE_URL=https://<your-tenant>.myfreshworks.com
# HEADED=1        # show the browser (local debugging only; default is headless)
# SLOWMO=500      # slow actions by N ms (local debugging only; default 0)

# --- Enterprise Playwright framework settings --------------------------------
# Keep timeout/wait values here rather than hardcoding milliseconds in test/page modules.
PW_TEST_TIMEOUT_MS=30000
PW_EXPECT_TIMEOUT_MS=10000
PW_ACTION_TIMEOUT_MS=10000
PW_NAVIGATION_TIMEOUT_MS=30000
PW_API_TIMEOUT_MS=30000
PW_EXPLICIT_WAIT_MS=1000

# Optional execution controls
PW_RETRIES=0
# 0 = let Playwright decide; set a positive number to cap workers.
PW_WORKERS=0
RUN_VISUAL=false

# Optional auth-state locations (relative to playwright-tests/)
# EVENTHUB_AUTH_FILE=.auth/user.json
# FRESHSALES_AUTH_FILE=.auth/freshsales-user.json
