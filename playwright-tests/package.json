{
  "name": "enterprise-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable enterprise Playwright functional and visual automation framework",
  "scripts": {
    "test": "playwright test",
    "test:functional": "playwright test tests/functional",
    "test:visual": "playwright test tests/visual",
    "test:visual:update": "playwright test tests/visual --update-snapshots",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:list": "playwright test --list",
    "test:debug": "cross-env HEADED=1 playwright test",
    "test:eventhub": "playwright test --project=setup-eventhub --project=chromium",
    "test:freshsales-help": "playwright test --project=freshsales-help",
    "test:ci": "cross-env CI=1 playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
