# Copy this file to .env.freshsales and fill in real values. Never commit .env.freshsales
# (already gitignored at the repo root via `.env.*`).
# Credentials for the rakesh-freshsales-ind-sep21 Freshsales tenant, used by
# tests/setup/auth.freshsales.setup.ts to log in once and share a storage-state session across
# the 'freshsales' project's specs.
#
# IMPORTANT: quote any value containing a '#' — dotenv treats an unquoted '#' as the start of a
# comment and will silently truncate the rest of the value.
FRESHSALES_URL=https://rakesh-freshsales-ind-sep21.myfreshworks.com/
FRESHSALES_EMAIL=your-test-account@example.com
FRESHSALES_PASSWORD="your-test-account-password"

# Used by api-tests/playwright-api's Freshsales suite (fixtures/freshsales-api-fixtures.ts) as a
# fallback auth path when scripted UI login is blocked by this tenant's reCAPTCHA challenge (see
# feedback/playwright-automation-agent/2026-09-21-freshsales-recaptcha-blocks-scripted-login.md).
# A human completes the login once interactively, then copies the resulting session cookie value
# (from browser dev tools -> Application -> Cookies) here. Leave unset to run only the
# non-authenticated subset of that suite (auth.spec.ts's unauthenticated-redirect checks).
FRESHSALES_SESSION_COOKIE=
